# Скопіюйте у .env і замініть CHANGE_ME (або запустіть scripts/init.sh — він згенерує паролі сам).
# .env у git НЕ потрапляє.
TZ=Europe/Kyiv
SIM_TZ_OFFSET=2

# Користувачі брокера (кожен має окремий пароль)
MQTT_ADMIN_PASSWORD=CHANGE_ME
MQTT_OPENHAB_PASSWORD=CHANGE_ME

# По одному користувачу на пристрій: dev_<назва> / MQTT_PW_<НАЗВА>
MQTT_PW_MOTION_LIVING=CHANGE_ME
MQTT_PW_MOTION_BEDROOM=CHANGE_ME
MQTT_PW_TEMPERATURE=CHANGE_ME
MQTT_PW_HUMIDITY=CHANGE_ME
MQTT_PW_LUX=CHANGE_ME
MQTT_PW_POWER=CHANGE_ME
MQTT_PW_LIGHT_LIVING=CHANGE_ME
MQTT_PW_LIGHT_BEDROOM=CHANGE_ME
MQTT_PW_HEATER=CHANGE_ME
